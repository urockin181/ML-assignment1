				    Selected = Table.SelectColumns(Promoted, {"report_date", "report_month", "weekday", "interval_start", "interval_end", "interval_minutes", "interval_start_hour", "interval_complete", "data_status", "has_activity", "queue_name", "queue_id", "media_type", "offered", "answered", "abandoned", "answered_within_sla", "over_sla", "handled", "handled_in_sla", "hold_count", "transfer_count", "service_level_pct_source", "service_level_pct_calc", "service_level_target_pct", "answer_pct_source", "answer_pct_calc", "abandon_pct_source", "abandon_pct_calc", "asa_seconds", "total_answer_wait_seconds", "avg_wait_seconds", "avg_handle_seconds", "total_handle_seconds", "avg_talk_seconds", "avg_hold_seconds", "avg_acw_seconds", "filters", "dq_flags", "source_file", "source_row", "load_timestamp"}, MissingField.UseNull),
