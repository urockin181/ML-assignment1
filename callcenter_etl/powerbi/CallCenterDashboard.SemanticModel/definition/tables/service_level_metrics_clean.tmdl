		lineageTag: b61414b9-bc5a-6c4f-7184-0d94745a355a

	measure 'Service Level % Color' = ```
			IF ( ISBLANK ( [Service Level %] ), BLANK (), IF ( [Service Level %] >= [Service Level Target %], "#107C10", "#C00000" ) )
			```
		isHidden
		displayFolder: Formatting
		lineageTag: 45951457-b3ed-79f3-375c-c7ab7f854940

	measure 'Abandon % Color' = ```
			IF ( ISBLANK ( [Abandon %] ), BLANK (), IF ( [Abandon %] <= [Abandon Target %], "#107C10", "#C00000" ) )
			```
		isHidden
		displayFolder: Formatting
		lineageTag: e7b0de21-f5de-b7dc-74c2-1d863eaeb215

