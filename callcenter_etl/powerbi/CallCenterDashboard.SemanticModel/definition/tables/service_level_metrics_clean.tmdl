			```
		formatString: #,0
		displayFolder: Service Level
		lineageTag: d3394034-5008-65d6-ce5d-14bf4e35f4c3

	measure 'Service Level %' = ```
			DIVIDE ( [Calls Within SLA], [Answered Calls] )
			```
		formatString: 0.0%
		displayFolder: Service Level
		lineageTag: 1aff3b16-6c21-0984-6d52-b0541ab3eb9f

	measure 'Abandon %' = ```
			DIVIDE ( [Abandoned Calls], [Offered Calls] )
			```
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: a76dbe26-9db5-b0f2-3849-47712e987163

	measure 'Answer %' = ```
			DIVIDE ( [Answered Calls], [Offered Calls] )
			```
		formatString: 0.0%
		displayFolder: Volume
		lineageTag: ff07c300-9f47-2948-7555-5e36638c6a5f

	measure 'ASA (sec)' = ```
			DIVIDE ( SUM ( service_level_metrics_clean[total_answer_wait_seconds] ), [Answered Calls] )
			```
		formatString: 0
		displayFolder: Speed
		lineageTag: 0ef5d7ec-45e2-8495-5cfa-43c3bb9a8ff2

	measure ASA = ```
			VAR _raw = [ASA (sec)]
			VAR _s = ROUND ( _raw, 0 )
			RETURN
			    IF (
			        ISBLANK ( _raw ),
			        BLANK (),
			        FORMAT ( INT ( _s / 3600 ), "00" ) & ":"
			            & FORMAT ( INT ( MOD ( _s, 3600 ) / 60 ), "00" ) & ":"
			            & FORMAT ( MOD ( _s, 60 ), "00" )
			    )
			```
		displayFolder: Speed
		lineageTag: 3b4c4384-8bf3-7dfd-588a-11739c508084

	measure 'Queue AHT (sec)' = ```
			DIVIDE ( SUM ( service_level_metrics_clean[total_handle_seconds] ), SUM ( service_level_metrics_clean[handled] ) )
			```
		formatString: 0
		displayFolder: Speed
		lineageTag: 90b5ec1f-dd00-ecff-e97f-141449f65d2a

	measure 'Queue AHT' = ```
			VAR _raw = [Queue AHT (sec)]
			VAR _s = ROUND ( _raw, 0 )
			RETURN
			    IF (
			        ISBLANK ( _raw ),
			        BLANK (),
			        FORMAT ( INT ( _s / 3600 ), "00" ) & ":"
			            & FORMAT ( INT ( MOD ( _s, 3600 ) / 60 ), "00" ) & ":"
			            & FORMAT ( MOD ( _s, 60 ), "00" )
			    )
			```
		displayFolder: Speed
		lineageTag: 7ea802f6-70a6-e60e-7ebe-7b491a2a1c8c

	measure 'Service Level Target %' = ```
			0.80
			```
		formatString: 0%
		displayFolder: Targets
		lineageTag: c493d162-8a52-c33d-3928-8813f1f1aace

	measure 'Abandon Target %' = ```
