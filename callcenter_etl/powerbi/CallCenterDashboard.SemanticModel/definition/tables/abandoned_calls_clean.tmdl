table abandoned_calls_clean
	lineageTag: 2e41ee4f-f0ab-75fd-3833-90a641c90a07

	measure 'Call Records' = ```
			COUNTROWS ( abandoned_calls_clean )
			```
		formatString: #,0
		lineageTag: 765f566f-abb7-8e52-c2d7-e28865ddfb3e

	measure 'Abandoned Calls (Detail)' = ```
			SUM ( abandoned_calls_clean[abandoned_flag] )
			```
		formatString: #,0
		lineageTag: 930f2191-7547-6fe2-6830-5315a23bddaa

	measure 'Abandon % (Detail)' = ```
			DIVIDE ( [Abandoned Calls (Detail)], [Call Records] )
			```
		formatString: 0.0%
		lineageTag: a9366e6b-64a6-c056-b04d-acfda116f6f9

	measure 'Avg Time to Abandon (sec)' = ```
			CALCULATE ( AVERAGE ( abandoned_calls_clean[time_to_abandon_seconds] ), KEEPFILTERS ( abandoned_calls_clean[is_abandoned] = TRUE () ) )
			```
		formatString: 0
		lineageTag: 852d9feb-e355-6dd9-e721-044ec5add3bc

	measure 'Avg Time to Abandon' = ```
			VAR _raw = [Avg Time to Abandon (sec)]
			VAR _s = ROUND ( _raw, 0 )
			RETURN
			    IF (
			        ISBLANK ( _raw ),
			        BLANK (),
			        FORMAT ( INT ( _s / 3600 ), "00" ) & ":"
			            & FORMAT ( INT ( MOD ( _s, 3600 ) / 60 ), "00" ) & ":"
			            & FORMAT ( MOD ( _s, 60 ), "00" )
			    )
			```
		lineageTag: f48b8873-b84a-0ca9-0fb9-6fcb8a096260

	measure 'Time to Abandon' = ```
			VAR _raw = CALCULATE ( SUM ( abandoned_calls_clean[time_to_abandon_seconds] ), KEEPFILTERS ( abandoned_calls_clean[is_abandoned] = TRUE () ) )
			VAR _s = ROUND ( _raw, 0 )
			RETURN
			    IF (
			        ISBLANK ( _raw ),
			        BLANK (),
			        FORMAT ( INT ( _s / 3600 ), "00" ) & ":"
			            & FORMAT ( INT ( MOD ( _s, 3600 ) / 60 ), "00" ) & ":"
			            & FORMAT ( MOD ( _s, 60 ), "00" )
			    )
			```
		lineageTag: 5fb0f7d2-9631-6836-ec62-34a0358ddbf4

