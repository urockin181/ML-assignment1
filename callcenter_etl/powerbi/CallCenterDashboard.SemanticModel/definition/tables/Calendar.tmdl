table Calendar
	lineageTag: 8ff922bb-cd8a-d41c-dfc4-8d3c5163b2ab
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0a203f8b-7baf-0b66-619c-4005b59c380d
		summarizeBy: none
		sourceColumn: Date
		isKey

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	column Year
		dataType: int64
		formatString: 0
		lineageTag: abfe6582-725e-7c23-8e2f-6cae2423906a
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column 'Month Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 97e07d91-a3e6-95eb-e7c5-a5950204c4e0
		summarizeBy: none
		sourceColumn: Month Sort

		annotation SummarizationSetBy = User

	column Month
		dataType: string
		lineageTag: 30525bd8-a80b-6e9a-e272-35b889d6b914
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Sort'

		annotation SummarizationSetBy = User

	column Day
