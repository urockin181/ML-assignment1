	measure 'AHT (sec)' = ```
			DIVIDE ( SUM ( agent_performance_clean[total_handle_seconds] ), [Handled (Agents)] )
			```
		formatString: 0
		displayFolder: Handle Time
		lineageTag: 437a629b-fbb6-6cb9-beed-190ff4226df6

	measure AHT = ```
			VAR _raw = [AHT (sec)]
			VAR _s = ROUND ( _raw, 0 )
			RETURN
			    IF (
			        ISBLANK ( _raw ),
			        BLANK (),
			        FORMAT ( INT ( _s / 3600 ), "00" ) & ":"
			            & FORMAT ( INT ( MOD ( _s, 3600 ) / 60 ), "00" ) & ":"
			            & FORMAT ( MOD ( _s, 60 ), "00" )
			    )
			```
		displayFolder: Handle Time
		lineageTag: b5af961c-45d7-452a-dfb9-be222f5d8e69

	measure 'Avg Talk (sec)' = ```
			DIVIDE ( SUMX ( agent_performance_clean, agent_performance_clean[avg_talk_seconds] * agent_performance_clean[handled] ), [Handled (Agents)] )
			```
		formatString: 0
		displayFolder: Handle Time
		lineageTag: 2510a15a-fe60-7f49-509e-fd6de288aa87

