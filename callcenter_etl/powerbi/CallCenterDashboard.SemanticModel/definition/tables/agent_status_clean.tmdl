	measure 'Other Off-Queue Sec' = ```
			SUMX ( agent_status_clean, MAX ( 0, agent_status_clean[off_queue_seconds] - ( agent_status_clean[available_seconds] + agent_status_clean[away_seconds] + agent_status_clean[break_seconds] + agent_status_clean[meal_seconds] + agent_status_clean[busy_seconds] + agent_status_clean[meeting_seconds] + agent_status_clean[training_seconds] ) ) )
			```
		formatString: 0
		isHidden
		displayFolder: Seconds
		lineageTag: 5a60a85b-be91-0c0a-86b3-6ba8a6b6941c

	measure 'Allowed Sec' = ```
			[On Queue Sec] - [Not Responding Sec] + [Available Sec] + [Break Sec] + [Meeting Sec] + [Training Sec]
			```
		formatString: 0
		isHidden
		displayFolder: Seconds
		lineageTag: 7fc967a0-46b5-4a35-a0be-deef615e7ee7

	measure 'Non-Allowed Sec' = ```
			[Not Responding Sec] + [Away Sec] + [Meal Sec] + [Busy Sec] + [Other Off-Queue Sec]
			```
		formatString: 0
		isHidden
		displayFolder: Seconds
		lineageTag: 3fab421e-952a-a45a-b49f-41c7d8c75884

	measure 'Logged In Hours' = ```
			DIVIDE ( [Logged In Sec], 3600 )
			```
		formatString: 0.00
		displayFolder: Hours
		lineageTag: fc55a068-45b9-df10-ff5e-19b0b1eadb8c

	measure 'Logged In Time' = ```
			VAR _raw = [Logged In Sec]
			VAR _s = ROUND ( _raw, 0 )
			RETURN
			    IF (
			        ISBLANK ( _raw ),
			        BLANK (),
			        FORMAT ( INT ( _s / 3600 ), "00" ) & ":"
			            & FORMAT ( INT ( MOD ( _s, 3600 ) / 60 ), "00" ) & ":"
			            & FORMAT ( MOD ( _s, 60 ), "00" )
			    )
			```
		displayFolder: Time (hh:mm:ss)
		lineageTag: dd79ffa0-62f1-a011-11a8-0dc60b7303cc

