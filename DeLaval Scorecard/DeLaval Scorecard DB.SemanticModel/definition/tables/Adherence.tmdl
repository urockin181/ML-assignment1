		annotation SummarizationSetBy = Automatic

	partition Adherence = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFile), null, true),
				    Sheet = Source{[Item = "Adherence", Kind = "Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"Agents", type text}, {"Date", type date}, {"Log In Time", type time}, {"Log Out Time", type time}, {"Shift Duration", type number}, {"Adherence", type text}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
